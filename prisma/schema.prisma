generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id             Int              @id @default(autoincrement())
  fullName       String
  grade          String?
  address        String?
  apartmentFloor String?
  parentPhone          String?
  note                 String?
  tuitionFeePerSession Float?           @default(0)
  previousUnpaidSessions Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  subjects       StudentSubject[]
  schedules      Schedule[]
}

model Subject {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  students  StudentSubject[]
  schedules Schedule[]
}

model StudentSubject {
  id        Int     @id @default(autoincrement())
  studentId Int
  subjectId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
}

enum ScheduleMode {
  ONLINE
  OFFLINE
}

model Schedule {
  id              Int          @id @default(autoincrement())
  studentId       Int
  subjectId       Int
  date            DateTime     @db.Date
  startTime       String       // Format: "HH:mm"
  endTime         String       // Format: "HH:mm"
  location        String?
  locationDetail  String?
  mode            ScheduleMode @default(OFFLINE)
  note            String?
  lessonPrepared  Boolean      @default(false)
  completed       Boolean      @default(false)
  isPaid          Boolean      @default(false)
  estimatedIncome Float?       @default(0)
  actualIncome    Float?       @default(0)
  teachingNote    String?
  notified30Min   Boolean      @default(false)
  notified1Hour   Boolean      @default(false)
  notified1Day    Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject         Subject      @relation(fields: [subjectId], references: [id])
  reminders       Reminder[]
}

model Reminder {
  id                  Int      @id @default(autoincrement())
  scheduleId          Int
  remindBeforeMinutes Int
  enabled             Boolean  @default(true)
  schedule            Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}
